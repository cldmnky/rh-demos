# The API image is the same Go program the app VM compiles at first boot.
FROM registry.access.redhat.com/ubi9/go-toolset:latest AS build
WORKDIR /opt/app-root/src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go store.go hub.go ./
RUN CGO_ENABLED=0 go build -o /tmp/orders .

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
COPY --from=build /tmp/orders /usr/local/bin/orders
ENV APP_RUNTIME=container
USER 1001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/orders"]
