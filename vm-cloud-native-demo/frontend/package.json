  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@types/node": "24.10.1"
  }
