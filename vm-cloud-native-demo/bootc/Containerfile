# Starting point; use an authorized RHEL registry and validate the tag.
FROM registry.redhat.io/rhel9/rhel-bootc:9.6
RUN dnf -y install mariadb-server qemu-guest-agent cloud-init && dnf clean all
RUN systemctl enable mariadb.service qemu-guest-agent.service cloud-init.target
# Database data, identity, credentials and cutover are intentionally not baked into the OS image.
