        <mxCell id="road2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d8ad5a;strokeWidth=4;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.44;" edge="1" source="transit" target="edge2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ebgp-label" value="eBGP  /  AS 65001 &lt;-&gt; AS 65002" style="text;html=1;align=center;fontFamily=Courier New;fontSize=18;fontColor=#e2bb6f;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="530" y="698" width="540" height="30" as="geometry"/></mxCell>
        <mxCell id="router-note" value="Edges sit OUTSIDE the clusters. They route IP and relay BGP/EVPN information." style="text;html=1;align=center;fontFamily=Courier New;fontSize=17;fontColor=#a3b697;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="890" width="1460" height="30" as="geometry"/></mxCell>
        <mxCell id="card1" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#13281b;strokeColor=#45663d;" vertex="1" parent="1"><mxGeometry x="70" y="948" width="470" height="158" as="geometry"/></mxCell>
        <mxCell id="card1-bar" value="" style="html=1;fillColor=#a4d779;strokeColor=none;" vertex="1" parent="card1"><mxGeometry x="0" y="0" width="470" height="5" as="geometry"/></mxCell>
        <mxCell id="card1-title" value="EVPN = THE DIRECTORY" style="text;html=1;align=left;fontFamily=Courier New;fontSize=23;fontColor=#b6f18a;fontStyle=1;spacing=0;" vertex="1" parent="card1"><mxGeometry x="22" y="21" width="430" height="35" as="geometry"/></mxCell>
        <mxCell id="card1-body" value="BGP shares workload MAC/IP locations&#xa;and the tunnel endpoints to reach them.&#xa;Dashed green = local BGP peering." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#c2cbb0;spacing=0;" vertex="1" parent="card1"><mxGeometry x="22" y="68" width="430" height="73" as="geometry"/></mxCell>
        <mxCell id="card2" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#13281b;strokeColor=#45663d;" vertex="1" parent="1"><mxGeometry x="565" y="948" width="470" height="158" as="geometry"/></mxCell>
        <mxCell id="card2-bar" value="" style="html=1;fillColor=#a4d779;strokeColor=none;" vertex="1" parent="card2"><mxGeometry x="0" y="0" width="470" height="5" as="geometry"/></mxCell>
        <mxCell id="card2-title" value="VXLAN = THE ENVELOPE" style="text;html=1;align=left;fontFamily=Courier New;fontSize=23;fontColor=#b6f18a;fontStyle=1;spacing=0;" vertex="1" parent="card2"><mxGeometry x="22" y="21" width="430" height="35" as="geometry"/></mxCell>
        <mxCell id="card2-body" value="Carries Ethernet inside UDP/IP.&#xa;VNI 110 identifies the virtual LAN.&#xa;Bright green = logical overlay path." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#c2cbb0;spacing=0;" vertex="1" parent="card2"><mxGeometry x="22" y="68" width="430" height="73" as="geometry"/></mxCell>
        <mxCell id="card3" value="" style="rounded=0;html=1;container=1;pointerEvents=0;fillColor=#27291b;strokeColor=#78683d;" vertex="1" parent="1"><mxGeometry x="1060" y="948" width="470" height="158" as="geometry"/></mxCell>
        <mxCell id="card3-bar" value="" style="html=1;fillColor=#d8ad5a;strokeColor=none;" vertex="1" parent="card3"><mxGeometry x="0" y="0" width="470" height="5" as="geometry"/></mxCell>
        <mxCell id="card3-title" value="L3 = THE ROAD" style="text;html=1;align=left;fontFamily=Courier New;fontSize=23;fontColor=#e2bb6f;fontStyle=1;spacing=0;" vertex="1" parent="card3"><mxGeometry x="22" y="21" width="430" height="35" as="geometry"/></mxCell>
        <mxCell id="card3-body" value="Routes packets between the two sites.&#xa;Needs VTEP reachability + VXLAN allowed.&#xa;Amber = routed transit + edge peering." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#d5c7a2;spacing=0;" vertex="1" parent="card3"><mxGeometry x="22" y="68" width="430" height="73" as="geometry"/></mxCell>
        <mxCell id="footer" value="SURVIVAL TIP: STRETCH THE VIRTUAL NETWORK. NOT THE PHYSICAL VLAN. NOT THE CLUSTER." style="text;html=1;align=center;fontFamily=Courier New;fontSize=18;fontColor=#e8e6bd;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="1130" width="1460" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
